# Cloud AI providers
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Get your DashScope / Qwen API key from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Regional endpoint for Qwen (intl or cn compatible-mode)
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional API key for custom OpenAI-compatible cloud endpoints
CUSTOM_API_KEY=your_custom_api_key_here

# Local AI runtimes
# Official Ollama local daemon endpoint (default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Official llama.cpp server endpoint (default: http://127.0.0.1:8080)
LLAMACPP_BASE_URL=http://127.0.0.1:8080

# Application configuration
PROVIDER_TIMEOUT_SECONDS=45
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
